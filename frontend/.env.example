# Copy to .env.local for development, and set the same variable in your host's
# build environment for deployments.
#
# Vite inlines import.meta.env at BUILD time, so this must be present when
# `npm run build` runs. Setting it afterwards has no effect on an existing
# bundle -- you have to rebuild.
#
# Include the /api suffix; the axios baseURL does not add it.
VITE_API_URL=http://127.0.0.1:8000/api
