# Copy this file to `.env` and fill in real values. Never commit `.env`.

# MongoDB Atlas connection string.
MONGODB_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Google AI Studio API key for the Gemini agents.
GOOGLE_API_KEY=

# Gemini model id. Model ids are retired over time; if the app starts failing
# with a 404 from Google, set a current id here.
# Note: the free tier allows only 5 requests/minute and one volunteer
# submission makes 4-6 model calls.
GEMINI_MODEL=gemini-2.5-flash

# Comma-separated list of origins allowed to call the API. Vite falls back to
# 5174/5175 when 5173 is taken, so include whichever port it actually reports.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# Where the ChromaDB vector store lives. Defaults to `<backend>/chroma_db`.
# Rebuild the index after changing this: python -m db.reset
CHROMA_PATH=

# Secret used to sign auth tokens (added in the auth phase). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=
